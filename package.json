{
  "name": "safra-control",
  "version": "1.0.0",
  "scripts": {
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node src/db/seed.ts",
    "test": "jest --runInBand --forceExit",
    "test:services": "jest --runInBand --forceExit --coverage --collectCoverageFrom='src/services/**/*.ts' --testPathPatterns='Service'",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src/",
    "lint:complexity": "eslint src/ --rule \"complexity:[warn,5]\"",
    "cpd": "jscpd src",
    "circular": "madge --circular src",
    "test:cov": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.5.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^30.4.2",
    "jscpd": "^5.0.9",
    "madge": "^8.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.0"
  }
}
