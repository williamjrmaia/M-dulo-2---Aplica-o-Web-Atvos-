<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Erro de autenticação &middot; Safra Control</title>
  <link rel="stylesheet" href="/css/atvos.css" />
</head>
<body class="login-page">
  <main class="login-card" aria-labelledby="titulo-erro">
    <div class="login-brand">
      <span class="brand-mark brand-mark-cane login-logo-mark" aria-hidden="true"><span></span></span>
      <span class="login-brand-name brand-wordmark">safra control</span>
    </div>

    <h1 id="titulo-erro" class="login-title">Erro de autenticação</h1>
    <p class="login-subtitle"><%= locals.message || 'Algo deu errado.' %></p>

    <a href="/login" class="btn btn-primary btn-full">Voltar ao login</a>
  </main>
</body>
</html>
