<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Entrar &middot; Safra Control</title>
  <link rel="stylesheet" href="/css/atvos.css" />
</head>
<body class="login-page">
  <main class="login-card" aria-labelledby="titulo-login">
    <div class="login-brand">
      <span class="brand-mark brand-mark-cane login-logo-mark" aria-hidden="true"><span></span></span>
      <span class="login-brand-name brand-wordmark">safra control</span>
    </div>

    <h1 id="titulo-login" class="login-title">Entrar</h1>
    <p class="login-subtitle">Acesse o sistema com seu e-mail e senha</p>

    <%- include('../partials/flash', { error: locals.error }) %>

    <form action="/login" method="POST" novalidate>
      <div class="form-group">
        <label class="form-label" for="email">E-mail</label>
        <input
          class="form-control"
          type="email"
          id="email"
          name="email"
          value="<%= locals.email || '' %>"
          placeholder="seu.email@atvos.com"
          autocomplete="username"
        />
      </div>

      <div class="form-group">
        <label class="form-label" for="senha">Senha</label>
        <input
          class="form-control"
          type="password"
          id="senha"
          name="senha"
          placeholder="••••••••"
          autocomplete="current-password"
        />
      </div>

      <button type="submit" class="btn btn-primary btn-full">Entrar</button>
    </form>

    <div class="login-demo-box">
      <strong>Usuários de demonstração:</strong>
      <ul>
        <li>juliano.soares@atvos.com — Analista</li>
        <li>bianca.souza@atvos.com — Coordenadora</li>
        <li>marcelo.andrade@atvos.com — Administrador</li>
      </ul>
      Senha para todos: <span class="code">demo123</span>
    </div>
  </main>
</body>
</html>
