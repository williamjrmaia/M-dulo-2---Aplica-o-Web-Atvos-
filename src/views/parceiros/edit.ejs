<%- include('../partials/header', { title: 'Editar Parceiro', active: 'parceiros' }) %>

<%
  const perfilAtual = locals.usuarioAutenticado && locals.usuarioAutenticado.perfil;
  const analistaAtual = perfilAtual === 'analista';
  const coordenadorAtual = perfilAtual === 'coordenador';
%>

<section aria-labelledby="titulo-edicao">
  <div class="page-header">
    <div class="page-back">
      <a href="/parceiros/<%= id %>" class="back-btn" aria-label="Voltar para o parceiro">←</a>
      <div class="page-header-text">
        <h1 id="titulo-edicao" class="page-title">Editar Parceiro</h1>
        <p class="subtitle">As alterações serão registradas no histórico de auditoria</p>
      </div>
    </div>
  </div>

  <div class="flash flash-info" role="status">
    <span class="flash-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
    <span class="flash-text"><strong>Preencha apenas os campos que deseja alterar.</strong> Campos em branco não serão modificados (comportamento PATCH).</span>
  </div>

  <%- include('../partials/flash', { error: locals.error }) %>

  <form action="/parceiros/<%= id %>/editar" method="POST" novalidate>
    <div class="form-card">
      <div class="form-card-header">
        <h2 class="section-title">Dados do Parceiro</h2>
        <p class="card-subtitle"><%= dados.nome ? 'Editando ' + dados.nome : 'Atualização cadastral do parceiro' %></p>
      </div>
      <div class="form-card-body">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="nome">Nome</label>
            <input class="form-control" type="text" id="nome" name="nome" value="<%= dados.nome || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="tipo_pessoa">Tipo de pessoa</label>
            <select class="form-select" id="tipo_pessoa" name="tipo_pessoa">
              <option value="">(não alterar)</option>
              <option value="fisica" <%= dados.tipo_pessoa === 'fisica' ? 'selected' : '' %>>Pessoa Física</option>
              <option value="juridica" <%= dados.tipo_pessoa === 'juridica' ? 'selected' : '' %>>Pessoa Jurídica</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="cpf_cnpj">CPF/CNPJ</label>
            <input class="form-control" type="text" id="cpf_cnpj" name="cpf_cnpj"
              value="<%= dados.cpf_cnpj || '' %>" data-mask="cpf-cnpj" />
          </div>

          <div class="form-group">
            <label class="form-label" for="papel">Papel</label>
            <select class="form-select" id="papel" name="papel">
              <option value="">(não alterar)</option>
              <option value="fornecedor" <%= dados.papel === 'fornecedor' ? 'selected' : '' %>>Fornecedor</option>
              <option value="proprietario" <%= dados.papel === 'proprietario' ? 'selected' : '' %>>Proprietário</option>
              <option value="ambos" <%= dados.papel === 'ambos' ? 'selected' : '' %>>Ambos (fornecedor e proprietário)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="apelido">Apelido</label>
            <input class="form-control" type="text" id="apelido" name="apelido" value="<%= dados.apelido || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">E-mail <span class="optional">(opcional no rascunho)</span></label>
            <input class="form-control" type="email" id="email" name="email" value="<%= dados.email || '' %>" />
            <p class="form-help">Pode ficar em branco ao salvar como rascunho, mas é <strong>obrigatório para enviar o registro à validação</strong>.</p>
          </div>

          <div class="form-group">
            <label class="form-label" for="data_nascimento">Data de nascimento</label>
            <input class="form-control" type="date" id="data_nascimento" name="data_nascimento" value="<%= dados.data_nascimento || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="nome_acompanhante">Nome do acompanhante</label>
            <input class="form-control" type="text" id="nome_acompanhante" name="nome_acompanhante" value="<%= dados.nome_acompanhante || '' %>" data-only-letters pattern="[A-Za-zÀ-ÿ\s'.\-]+" title="Apenas letras" />
          </div>

          <div class="form-group">
            <label class="form-label" for="telefone">Telefone</label>
            <input class="form-control" type="text" id="telefone" name="telefone" value="<%= dados.telefone || '' %>" data-mask="telefone" data-only-numbers inputmode="tel" pattern="[0-9()+\-\s]+" title="Apenas números" />
          </div>

          <div class="form-group">
            <label class="form-label" for="regiao">Região</label>
            <input class="form-control" type="text" id="regiao" name="regiao" value="<%= dados.regiao || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="inscricao_estadual">Inscrição Estadual</label>
            <input class="form-control" type="text" id="inscricao_estadual" name="inscricao_estadual" value="<%= dados.inscricao_estadual || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="usina_referencia">Usina de Referência</label>
            <input class="form-control" type="text" id="usina_referencia" name="usina_referencia" value="<%= dados.usina_referencia || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="area_plantada">Área Plantada</label>
            <input class="form-control" type="text" id="area_plantada" name="area_plantada" value="<%= dados.area_plantada || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="tch_medio">TCH Médio</label>
            <input class="form-control" type="text" id="tch_medio" name="tch_medio" value="<%= dados.tch_medio || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="atr_medio">ATR Médio</label>
            <input class="form-control" type="text" id="atr_medio" name="atr_medio" value="<%= dados.atr_medio || '' %>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="status">Status</label>
            <% if (analistaAtual) { %>
              <%# Analista nao altera o status por aqui: usa o botao explicito "Enviar para validacao". %>
              <input type="hidden" name="status" id="status" value="" />
              <% if (['rascunho', 'devolvido'].includes(dados.status)) { %>
                <p class="form-help">Para enviar este registro para validação, use o botão <strong>“Enviar para validação”</strong> abaixo.</p>
              <% } else { %>
                <p class="form-help">Status atual: <strong><%= dados.status %></strong></p>
              <% } %>
            <% } else { %>
              <select class="form-select" id="status" name="status">
                <option value="">(não alterar)</option>
                <option value="rascunho" <%= dados.status === 'rascunho' ? 'selected' : '' %>>Rascunho</option>
                <option value="pendente" <%= dados.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                <option value="ativo" <%= dados.status === 'ativo' ? 'selected' : '' %>>Ativo</option>
                <option value="devolvido" <%= dados.status === 'devolvido' ? 'selected' : '' %>>Devolvido</option>
                <% if (!coordenadorAtual) { %>
                  <option value="inativo" <%= dados.status === 'inativo' ? 'selected' : '' %>>Inativo</option>
                <% } %>
              </select>
            <% } %>
          </div>

          <div class="form-group span-2">
            <label class="form-label" for="observacoes">Observações</label>
            <textarea class="form-textarea" id="observacoes" name="observacoes"><%= dados.observacoes || '' %></textarea>
          </div>

          <% if (analistaAtual && dados.status === 'devolvido' && dados.comentario_devolucao) { %>
            <div class="form-group span-2">
              <label class="form-label">Comentário da devolução</label>
              <div class="flash flash-warning" role="status">
                <span class="flash-text"><%= dados.comentario_devolucao %></span>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/parceiros/<%= id %>" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      <% if (analistaAtual && ['rascunho', 'devolvido'].includes(dados.status)) { %>
        <button type="submit" class="btn btn-export" data-enviar-validacao>Enviar para validação</button>
      <% } %>
    </div>
  </form>

  <script>
    // Restringe a digitação: campos "apenas letras" e "apenas números" (com máscara de telefone).
    (function () {
      document.querySelectorAll('[data-only-letters]').forEach(function (el) {
        el.addEventListener('input', function () {
          this.value = this.value.replace(/[^A-Za-zÀ-ÿ\s'.\-]/g, '');
        });
      });
      document.querySelectorAll('[data-only-numbers]').forEach(function (el) {
        el.addEventListener('input', function () {
          this.value = this.value.replace(/[^0-9()+\-\s]/g, '');
        });
      });
    })();
  </script>

  <% if (analistaAtual) { %>
    <script>
      (function () {
        var btn = document.querySelector('[data-enviar-validacao]');
        var statusInput = document.getElementById('status');
        if (btn && statusInput) {
          // Ao clicar no botao explicito, marca o envio para validacao (status=pendente).
          btn.addEventListener('click', function () { statusInput.value = 'pendente'; });
        }
      })();
    </script>
  <% } %>
</section>

<%- include('../partials/footer') %>
