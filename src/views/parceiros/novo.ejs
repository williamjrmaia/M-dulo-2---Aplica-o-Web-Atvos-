<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title>Cadastrar Parceiro</title>
  <style>
    body { font-family: Tahoma, sans-serif; max-width: 560px; margin: 40px auto; padding: 0 16px; color: #3F5B70; }
    h1 { margin-bottom: 4px; color: #3F5B70; }
    .subtitle { color: #64748b; margin-top: 0; margin-bottom: 24px; font-size: 14px; }
    .nav { margin-bottom: 24px; }
    .nav a { color: #FF681A; text-decoration: none; font-weight: bold; }
    .nav a:hover { text-decoration: underline; }
    .obrigatorios { font-size: 13px; color: #64748b; margin: 12px 0 24px; }
    label { display: block; margin-bottom: 14px; font-weight: bold; font-size: 14px; }
    input, select { display: block; width: 100%; padding: 8px 10px; margin-top: 6px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 4px; font-family: Tahoma, sans-serif; font-size: 14px; }
    input:focus, select:focus { outline: none; border-color: #FF681A; box-shadow: 0 0 0 3px rgba(255, 104, 26, 0.15); }
    button { padding: 10px 24px; background: #FF681A; color: #fff; border: none; cursor: pointer; border-radius: 4px; font-family: Tahoma, sans-serif; font-weight: bold; font-size: 14px; }
    button:hover { background: #FF8100; }
    .error { background: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; padding: 12px 14px; border-radius: 4px; margin-bottom: 20px; font-size: 14px; }
    .opcional { font-weight: normal; color: #94a3b8; font-size: 12px; }
  </style>
</head>
<body>
  <div class="nav">
    <a href="/parceiros">&larr; Ver todos os parceiros</a>
  </div>

  <h1>Cadastrar Parceiro</h1>
  <p class="subtitle">Cadastro centralizado de fornecedor de cana ou proprietário cedente</p>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <p class="obrigatorios">Campos com <strong>*</strong> são obrigatórios</p>

  <form action="/parceiros" method="POST">
    <label>Nome *
      <input type="text" name="nome" value="<%= dados.nome || '' %>" required />
    </label>

    <label>Tipo de pessoa *
      <select name="tipo_pessoa" required>
        <option value="">Selecione...</option>
        <option value="fisica" <%= dados.tipo_pessoa === 'fisica' ? 'selected' : '' %>>Pessoa Física</option>
        <option value="juridica" <%= dados.tipo_pessoa === 'juridica' ? 'selected' : '' %>>Pessoa Jurídica</option>
      </select>
    </label>

    <label>CPF/CNPJ *
      <input type="text" name="cpf_cnpj" value="<%= dados.cpf_cnpj || '' %>" required />
    </label>

    <label>Apelido <span class="opcional">(opcional)</span>
      <input type="text" name="apelido" value="<%= dados.apelido || '' %>" />
    </label>

    <label>E-mail <span class="opcional">(opcional)</span>
      <input type="email" name="email" value="<%= dados.email || '' %>" />
    </label>

    <label>Data de nascimento <span class="opcional">(opcional)</span>
      <input type="date" name="data_nascimento" value="<%= dados.data_nascimento || '' %>" />
    </label>

    <label>Nome do acompanhante <span class="opcional">(opcional)</span>
      <input type="text" name="nome_acompanhante" value="<%= dados.nome_acompanhante || '' %>" />
    </label>

    <button type="submit">Salvar</button>
  </form>
</body>
</html>
