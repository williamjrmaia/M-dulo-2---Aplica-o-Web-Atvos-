<%- include('../partials/header', { title: naoEncontrado ? 'Parceiro não encontrado' : `Parceiro: ${parceiro.nome}` }) %>

<% if (naoEncontrado) { %>
  <section aria-labelledby="titulo-404">
    <h1 id="titulo-404">Parceiro não encontrado</h1>
    <div class="empty-state">
      <strong>404</strong>
      <p>Nenhum parceiro corresponde ao ID informado.</p>
    </div>
  </section>
<% } else { %>
  <section aria-labelledby="titulo-detalhe">
    <h1 id="titulo-detalhe"><%= parceiro.nome %></h1>
    <p class="subtitle">Detalhes do parceiro</p>

    <div class="actions">
      <a href="/parceiros/<%= parceiro.id %>/editar" class="btn">Editar parceiro</a>
    </div>

    <article class="card" aria-labelledby="dados-cadastrais">
      <header class="card-header" id="dados-cadastrais">Dados cadastrais</header>
      <dl>
        <dt>ID</dt>
        <dd><code><%= parceiro.id %></code></dd>

        <dt>Nome</dt>
        <dd><%= parceiro.nome %></dd>

        <dt>Apelido</dt>
        <dd><%= parceiro.apelido || '—' %></dd>

        <dt>Tipo de pessoa</dt>
        <dd><%= parceiro.tipo_pessoa === 'fisica' ? 'Pessoa Física' : 'Pessoa Jurídica' %></dd>

        <dt>CPF/CNPJ</dt>
        <dd><%= parceiro.cpf_cnpj %></dd>

        <dt>E-mail</dt>
        <dd><%= parceiro.email || '—' %></dd>

        <dt>Data de nascimento</dt>
        <dd><%= parceiro.data_nascimento ? new Date(parceiro.data_nascimento).toLocaleDateString('pt-BR') : '—' %></dd>

        <dt>Nome do acompanhante</dt>
        <dd><%= parceiro.nome_acompanhante || '—' %></dd>

        <dt>Status</dt>
        <dd><span class="badge badge-<%= parceiro.status %>"><%= parceiro.status %></span></dd>

        <dt>Criado em</dt>
        <dd><%= new Date(parceiro.criado_em).toLocaleString('pt-BR') %></dd>

        <dt>Criado por</dt>
        <dd><code><%= parceiro.criado_por %></code></dd>

        <dt>Atualizado em</dt>
        <dd><%= parceiro.atualizado_em ? new Date(parceiro.atualizado_em).toLocaleString('pt-BR') : '—' %></dd>

        <dt>Atualizado por</dt>
        <dd><%= parceiro.atualizado_por || '—' %></dd>
      </dl>
    </article>
  </section>
<% } %>

<%- include('../partials/footer') %>
