<%- include('../partials/header', { title: naoEncontrado ? 'Parceiro não encontrado' : `Parceiro: ${parceiro.nome}`, active: 'parceiros' }) %>

<% if (naoEncontrado) { %>
  <section aria-labelledby="titulo-404">
    <div class="page-header">
      <div class="page-back">
        <a href="/parceiros" class="back-btn" aria-label="Voltar para a lista de parceiros">←</a>
        <div class="page-header-text">
          <h1 id="titulo-404" class="page-title">Parceiro não encontrado</h1>
        </div>
      </div>
    </div>
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/></svg></div>
      <p class="empty-title">Parceiro não encontrado</p>
      <p class="empty-text">Nenhum parceiro corresponde ao ID informado.</p>
      <a href="/parceiros" class="btn btn-primary empty-action">Voltar para Parceiros</a>
    </div>
  </section>
<% } else { %>
  <%- include('../partials/flash', { error: locals.error, info: locals.info }) %>

  <section aria-labelledby="titulo-detalhe">
    <div class="page-header">
      <div class="page-back">
        <a href="/parceiros" class="back-btn" aria-label="Voltar para a lista de parceiros">←</a>
        <div class="page-header-text">
          <h1 id="titulo-detalhe" class="page-title">
            <%= parceiro.nome %>
            <span class="badge badge-<%= parceiro.status %>"><%= parceiro.status %></span>
          </h1>
          <p class="subtitle">Detalhes do parceiro</p>
        </div>
      </div>
      <div class="page-header-actions">
        <button type="button" class="btn btn-secondary" data-modal-open data-modal-target="modal-interacao">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Registrar Interação
        </button>
        <a href="/parceiros/<%= parceiro.id %>/editar" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
          Editar
        </a>
      </div>
    </div>

    <div class="detail-layout">
      <div class="detail-main">
        <article class="card" aria-labelledby="info-cadastrais">
          <div class="card-header">
            <h2 class="card-title" id="info-cadastrais">Informações Cadastrais</h2>
          </div>
          <div class="card-body">
            <div class="info-grid">
              <div class="definition-list">
                <p class="term">Nome</p>
                <p class="value"><%= parceiro.nome %></p>
              </div>
              <div class="definition-list">
                <p class="term">Apelido</p>
                <p class="value"><%= parceiro.apelido || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Tipo de pessoa</p>
                <p class="value"><%= parceiro.tipo_pessoa === 'fisica' ? 'Pessoa Física' : 'Pessoa Jurídica' %></p>
              </div>
              <div class="definition-list">
                <p class="term">CPF/CNPJ</p>
                <p class="value"><%= parceiro.cpf_cnpj %></p>
              </div>
              <div class="definition-list">
                <p class="term">E-mail</p>
                <p class="value"><%= parceiro.email || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Data de nascimento</p>
                <p class="value"><%= parceiro.data_nascimento ? new Date(parceiro.data_nascimento).toLocaleDateString('pt-BR') : '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Nome do acompanhante</p>
                <p class="value"><%= parceiro.nome_acompanhante || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Telefone</p>
                <p class="value"><%= parceiro.telefone || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Região</p>
                <p class="value"><%= parceiro.regiao || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Inscrição Estadual</p>
                <p class="value"><%= parceiro.inscricao_estadual || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Usina de Referência</p>
                <p class="value"><%= parceiro.usina_referencia || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Área Plantada</p>
                <p class="value"><%= parceiro.area_plantada || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">TCH Médio</p>
                <p class="value"><%= parceiro.tch_medio || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">ATR Médio</p>
                <p class="value"><%= parceiro.atr_medio || '—' %></p>
              </div>
              <div class="definition-list">
                <p class="term">Status</p>
                <p class="value"><span class="badge badge-<%= parceiro.status %>"><%= parceiro.status %></span></p>
              </div>
              <div class="definition-list span-2">
                <p class="term">Observações</p>
                <p class="value"><%= parceiro.observacoes || '—' %></p>
              </div>
            </div>
          </div>
        </article>

        <article class="card" aria-labelledby="historico">
          <div class="card-header">
            <h2 class="card-title" id="historico">Histórico de Interações</h2>
          </div>
          <div class="card-body">
            <% var historico = (typeof parceiro.historico !== 'undefined' && parceiro.historico) ? parceiro.historico : []; %>
            <% if (historico.length === 0) { %>
              <div class="empty-state">
                <div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                <p class="empty-title">Nenhuma interação registrada</p>
                <p class="empty-text">As interações com este parceiro aparecerão aqui em ordem cronológica.</p>
              </div>
            <% } else { %>
              <ul class="timeline">
                <% historico.forEach(function(item) { %>
                  <li class="timeline-item">
                    <span class="timeline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                    <div class="timeline-head">
                      <span class="timeline-type"><%= item.tipo %></span>
                      <span><%= item.data ? new Date(item.data).toLocaleString('pt-BR') : '' %></span>
                      <% if (item.autor) { %><span class="font-bold">por <%= item.autor %></span><% } %>
                    </div>
                    <div class="timeline-body"><%= item.descricao %></div>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </article>
      </div>

      <aside class="detail-sidebar">
        <article class="card" aria-labelledby="info-cadastro">
          <div class="card-header">
            <h2 class="card-title" id="info-cadastro">Informações de Cadastro</h2>
          </div>
          <div class="card-body stack-4">
            <div class="definition-list">
              <p class="term">ID</p>
              <p class="value"><span class="code"><%= parceiro.id %></span></p>
            </div>
            <div class="definition-list">
              <p class="term">Criado em</p>
              <p class="value"><%= new Date(parceiro.criado_em).toLocaleString('pt-BR') %></p>
            </div>
            <div class="definition-list">
              <p class="term">Criado por</p>
              <p class="value"><span class="code"><%= parceiro.criado_por %></span></p>
            </div>
            <div class="definition-list">
              <p class="term">Atualizado em</p>
              <p class="value"><%= parceiro.atualizado_em ? new Date(parceiro.atualizado_em).toLocaleString('pt-BR') : '—' %></p>
            </div>
            <div class="definition-list">
              <p class="term">Atualizado por</p>
              <p class="value"><%= parceiro.atualizado_por || '—' %></p>
            </div>
          </div>
        </article>
      </aside>
    </div>
  </section>

  <!-- Modal: Registrar Interação (visual — sem rota de submissão no backend atual) -->
  <div class="modal-backdrop" id="modal-interacao" role="dialog" aria-modal="true" aria-labelledby="modal-interacao-title">
    <div class="modal-card">
      <div class="modal-header">
        <h2 class="modal-title" id="modal-interacao-title">Registrar Interação</h2>
        <button type="button" class="modal-close" data-modal-close aria-label="Fechar">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="interacao-tipo">Tipo de interação</label>
          <select class="form-select" id="interacao-tipo">
            <option>Visita</option>
            <option>Ligação</option>
            <option>WhatsApp</option>
            <option>Reunião</option>
            <option>Observação</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="interacao-desc">Descrição</label>
          <textarea class="form-textarea" id="interacao-desc" placeholder="Descreva a interação com o parceiro..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Cancelar</button>
        <button type="button" class="btn btn-primary" data-modal-close>Salvar Interação</button>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
