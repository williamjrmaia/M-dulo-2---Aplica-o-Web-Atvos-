<% if (typeof error !== 'undefined' && error) { %>
  <div class="flash flash-error" role="alert" data-flash>
    <span class="flash-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></span>
    <span class="flash-text"><%= error %></span>
    <button type="button" class="flash-close" data-flash-close aria-label="Fechar alerta">&times;</button>
  </div>
<% } %>
<% if (typeof info !== 'undefined' && info) { %>
  <div class="flash flash-info" role="status" data-flash>
    <span class="flash-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
    <span class="flash-text"><%= info %></span>
    <button type="button" class="flash-close" data-flash-close aria-label="Fechar alerta">&times;</button>
  </div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <div class="flash flash-success" role="status" data-flash>
    <span class="flash-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span>
    <span class="flash-text"><%= success %></span>
    <button type="button" class="flash-close" data-flash-close aria-label="Fechar alerta">&times;</button>
  </div>
<% } %>
<% if (typeof warning !== 'undefined' && warning) { %>
  <div class="flash flash-warning" role="status" data-flash>
    <span class="flash-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
    <span class="flash-text"><%= warning %></span>
    <button type="button" class="flash-close" data-flash-close aria-label="Fechar alerta">&times;</button>
  </div>
<% } %>
