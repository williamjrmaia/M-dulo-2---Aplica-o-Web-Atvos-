<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'ATVOS CRM' %></title>
  <link rel="stylesheet" href="/css/atvos.css" />
</head>
<body>
  <header class="app-header" role="banner">
    <nav aria-label="Navegação principal">
      <span class="brand">ATVOS CRM</span>
      <a href="/parceiros">Parceiros</a>
      <a href="/parceiros/novo">+ Novo Parceiro</a>
      <% if (locals.usuarioAutenticado) { %>
        <span class="user-chip">
          <%= locals.usuarioAutenticado.nome %>
          <% if (locals.usuarioAutenticado.perfil) { %>
            · <%= locals.usuarioAutenticado.perfil %>
          <% } %>
        </span>
        <form action="/logout" method="POST" class="logout-form">
          <button type="submit" class="logout-link">Sair</button>
        </form>
      <% } %>
    </nav>
  </header>
  <main role="main">
