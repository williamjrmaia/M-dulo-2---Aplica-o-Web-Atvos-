<%- include('../partials/header', { title: 'Nova Terra', active: 'terras' }) %>

<section aria-labelledby="titulo-terra">
  <div class="page-header">
    <div class="page-back">
      <a href="/terras" class="back-btn" aria-label="Voltar para terras">←</a>
      <div class="page-header-text">
        <h1 id="titulo-terra" class="page-title">Nova Terra</h1>
        <p class="subtitle">Cadastro de área rural para vínculo com parceiros</p>
      </div>
    </div>
  </div>

  <%- include('../partials/flash', { error: locals.error }) %>

  <form action="/terras" method="POST" novalidate>
    <div class="form-card">
      <div class="form-card-header">
        <h2 class="section-title">Dados da Terra</h2>
        <p class="card-subtitle">Campos marcados com <span class="required">*</span> são obrigatórios</p>
      </div>
      <div class="form-card-body">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="nome">Nome <span class="required">*</span></label>
            <input class="form-control" id="nome" name="nome" value="<%= dados.nome || '' %>" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="area_contratada_ha">Área contratada (ha) <span class="required">*</span></label>
            <input class="form-control" type="number" step="0.01" min="0.01" id="area_contratada_ha" name="area_contratada_ha" value="<%= dados.area_contratada_ha || '' %>" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="cidade">Cidade <span class="required">*</span></label>
            <input class="form-control" id="cidade" name="cidade" value="<%= dados.cidade || '' %>" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="estado">Estado <span class="required">*</span></label>
            <input class="form-control" id="estado" name="estado" value="<%= dados.estado || '' %>" maxlength="2" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
              <option value="rascunho" <%= dados.status === 'rascunho' ? 'selected' : '' %>>Rascunho</option>
              <option value="ativo" <%= dados.status === 'ativo' ? 'selected' : '' %>>Ativo</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="form-actions">
      <a href="/terras" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary">Salvar Terra</button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
