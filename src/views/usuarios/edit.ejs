<%- include('../partials/header', { title: 'Editar Usuário', active: 'usuarios' }) %>

<section aria-labelledby="titulo-editar-usuario">
  <div class="page-header">
    <div class="page-back">
      <a href="/parceiros" class="back-btn" aria-label="Voltar">←</a>
      <div class="page-header-text">
        <h1 id="titulo-editar-usuario" class="page-title">Editar Usuário</h1>
        <p class="subtitle">Atualize os dados de acesso do usuário</p>
      </div>
    </div>
  </div>

  <%- include('../partials/flash', { error: error }) %>

  <% if (usuario) { %>
    <form method="POST" action="/usuarios/<%= usuario.id %>" novalidate>
      <div class="form-card">
        <div class="form-card-header">
          <h2 class="section-title">Informações do Usuário</h2>
          <p class="card-subtitle">Campos marcados com <span class="required">*</span> são obrigatórios</p>
        </div>
        <div class="form-card-body">
          <div class="form-group">
            <label class="form-label" for="nome">Nome <span class="required">*</span></label>
            <input class="form-control" id="nome" name="nome" value="<%= usuario.nome || '' %>" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">E-mail <span class="required">*</span></label>
            <input class="form-control" id="email" name="email" type="email" value="<%= usuario.email || '' %>" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="ativo">Status</label>
            <select class="form-select" id="ativo" name="ativo">
              <option value="true" <%= usuario.ativo === true || usuario.ativo === 'true' ? 'selected' : '' %>>Ativo</option>
              <option value="false" <%= usuario.ativo === false || usuario.ativo === 'false' ? 'selected' : '' %>>Inativo</option>
            </select>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <a href="/parceiros" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </div>
    </form>
  <% } else { %>
    <div class="empty-state">
      <p class="empty-title">Usuário indisponível</p>
      <p class="empty-text">Não foi possível carregar os dados deste usuário.</p>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
