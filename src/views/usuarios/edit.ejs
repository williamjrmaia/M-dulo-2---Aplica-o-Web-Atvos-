<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar usuario</title>
  </head>
  <body>
    <main>
      <h1>Editar usuario</h1>

      <% if (error) { %>
        <p><%= error %></p>
      <% } %>

      <% if (usuario) { %>
        <form method="POST" action="/usuarios/<%= usuario.id %>">
          <label for="nome">Nome</label>
          <input id="nome" name="nome" value="<%= usuario.nome || '' %>" required />

          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" value="<%= usuario.email || '' %>" required />

          <label for="ativo">Status</label>
          <select id="ativo" name="ativo">
            <option value="true" <%= usuario.ativo === true || usuario.ativo === 'true' ? 'selected' : '' %>>Ativo</option>
            <option value="false" <%= usuario.ativo === false || usuario.ativo === 'false' ? 'selected' : '' %>>Inativo</option>
          </select>

          <button type="submit">Salvar alteracoes</button>
        </form>
      <% } %>
    </main>
  </body>
</html>
