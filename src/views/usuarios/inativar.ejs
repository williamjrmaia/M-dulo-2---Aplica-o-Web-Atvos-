<%- include('../partials/header', { title: 'Inativar Usuário', active: 'usuarios' }) %>

<section aria-labelledby="titulo-inativar-usuario">
  <div class="page-header">
    <div class="page-back">
      <a href="/usuarios" class="back-btn" aria-label="Voltar">←</a>
      <div class="page-header-text">
        <h1 id="titulo-inativar-usuario" class="page-title">Inativar Usuário</h1>
        <p class="subtitle"><%= usuario && usuario.nome ? usuario.nome : 'Revogue o acesso de um usuário ao sistema' %></p>
      </div>
    </div>
  </div>

  <%- include('../partials/flash', { error: error }) %>

  <% if (usuario) { %>
    <div class="form-card" style="max-width: 520px; margin: 0 auto;">
      <div class="form-card-header">
        <h2 class="section-title">Confirmar Inativação</h2>
      </div>
      <div class="form-card-body">
        <p class="text-secondary mt-0">
          Tem certeza que deseja inativar o usuário
          <strong><%= usuario.nome || usuario.id %></strong>?
        </p>
        <div class="flash flash-warning mb-0" role="status">
          <span class="flash-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
          <span class="flash-text">O acesso será revogado, mas o <strong>histórico será preservado</strong>.</span>
        </div>
      </div>
      <div class="card-footer">
        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
        <form method="POST" action="/usuarios/<%= usuario.id %>/inativar">
          <button type="submit" class="btn btn-danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            Confirmar Inativação
          </button>
        </form>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state">
      <p class="empty-title">Usuário indisponível</p>
      <p class="empty-text">Não foi possível carregar os dados deste usuário.</p>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
