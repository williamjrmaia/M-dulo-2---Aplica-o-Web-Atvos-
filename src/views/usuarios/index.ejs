<%- include('../partials/header', { title: 'Gestão de Usuários', active: 'usuarios' }) %>

<%- include('../partials/flash', { error: error }) %>

<section aria-labelledby="titulo-usuarios">
  <div class="page-header">
    <div class="page-header-text">
      <h1 id="titulo-usuarios" class="page-title">Gestão de Usuários</h1>
      <p class="subtitle">Usuários com acesso ao Safra Control e seus perfis</p>
    </div>
    <div class="page-header-actions">
      <a href="/usuarios/novo" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Novo Usuário
      </a>
    </div>
  </div>

  <div class="list-toolbar">
    <div class="search-bar">
      <span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
      <input type="search" class="search-input" placeholder="Buscar por nome ou e-mail..." aria-label="Buscar usuários" data-search-input data-search-target="lista-usuarios" />
    </div>
  </div>

  <% if (!usuarios || usuarios.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
      <p class="empty-title">Nenhum usuário cadastrado</p>
      <p class="empty-text">Cadastre o primeiro usuário do sistema.</p>
      <a href="/usuarios/novo" class="btn btn-primary empty-action">+ Novo Usuário</a>
    </div>
  <% } else { %>
    <div class="user-list" id="lista-usuarios">
      <% usuarios.forEach(function(u) { %>
        <article class="user-list-item" data-search-item data-search-text="<%= (u.nome || '') + ' ' + (u.email || '') %>">
          <div class="list-item-head">
            <h2 class="list-item-title"><%= u.nome %></h2>
            <span class="badge badge-<%= u.ativo ? 'ativo' : 'inativo' %>"><%= u.ativo ? 'Ativo' : 'Inativo' %></span>
            <div class="list-item-actions">
              <a href="/usuarios/<%= u.id %>/editar" class="btn btn-secondary btn-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                Editar
              </a>
              <a href="/usuarios/<%= u.id %>/inativar" class="btn btn-danger-outline btn-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Inativar
              </a>
            </div>
          </div>

          <div class="list-item-grid">
            <div>
              <p class="field-label">E-mail</p>
              <p class="field-value"><%= u.email %></p>
            </div>
            <div>
              <p class="field-label">Perfil</p>
              <p class="field-value">
                <% if (u.perfil) { %>
                  <span class="badge badge-<%= u.perfil %>"><%= u.perfil %></span>
                <% } else { %>—<% } %>
              </p>
            </div>
            <div>
              <p class="field-label">Cadastrado em</p>
              <p class="field-value"><%= u.criado_em ? new Date(u.criado_em).toLocaleDateString('pt-BR') : '—' %></p>
            </div>
          </div>
        </article>
      <% }) %>
      <div class="empty-state" data-search-empty hidden>
        <p class="empty-title">Nenhum usuário encontrado</p>
        <p class="empty-text">Ajuste o termo de busca para ver os usuários cadastrados.</p>
      </div>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
