<%- include('../partials/header', { title: 'Novo Usuário', active: 'usuarios' }) %>

<section aria-labelledby="titulo-novo-usuario">
  <div class="page-header">
    <div class="page-back">
      <a href="/usuarios" class="back-btn" aria-label="Voltar para a gestão de usuários">←</a>
      <div class="page-header-text">
        <h1 id="titulo-novo-usuario" class="page-title">Novo Usuário</h1>
        <p class="subtitle">Conceda acesso ao Safra Control definindo o perfil do usuário</p>
      </div>
    </div>
  </div>

  <%- include('../partials/flash', { error: locals.error }) %>

  <form action="/usuarios" method="POST" novalidate>
    <div class="form-card">
      <div class="form-card-header">
        <h2 class="section-title">Informações do Usuário</h2>
        <p class="card-subtitle">Campos marcados com <span class="required">*</span> são obrigatórios</p>
      </div>
      <div class="form-card-body">
        <div class="form-group">
          <label class="form-label" for="nome">Nome <span class="required">*</span></label>
          <input class="form-control" type="text" id="nome" name="nome" value="<%= dados.nome || '' %>" placeholder="Nome completo do usuário" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="email">E-mail <span class="required">*</span></label>
          <input class="form-control" type="email" id="email" name="email" value="<%= dados.email || '' %>" placeholder="usuario@atvos.com" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="perfil_acesso_id">Perfil de Acesso <span class="required">*</span></label>
          <select class="form-select" id="perfil_acesso_id" name="perfil_acesso_id" required>
            <option value="">Selecione...</option>
            <% (perfis || []).forEach(function(p) { %>
              <option value="<%= p.id %>" <%= dados.perfil_acesso_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="unidade">Unidade <span class="optional">(opcional)</span></label>
          <input class="form-control" type="text" id="unidade" name="unidade" value="<%= dados.unidade || '' %>" placeholder="Ex: Ribeirão Preto" />
        </div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary">Cadastrar Usuário</button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
