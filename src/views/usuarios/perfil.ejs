<%- include('../partials/header', { title: 'Perfil de Acesso', active: 'usuarios' }) %>

<section aria-labelledby="titulo-perfil-usuario">
  <div class="page-header">
    <div class="page-back">
      <a href="/usuarios" class="back-btn" aria-label="Voltar">←</a>
      <div class="page-header-text">
        <h1 id="titulo-perfil-usuario" class="page-title">Perfil de Acesso do Usuário</h1>
        <p class="subtitle"><%= usuario && usuario.nome ? usuario.nome : 'Defina o nível de permissão do usuário no sistema' %></p>
      </div>
    </div>
  </div>

  <%- include('../partials/flash', { error: locals.error }) %>

  <% if (usuario) { %>
    <form method="POST" action="/usuarios/<%= usuario.id %>/perfil" novalidate>
      <div class="form-card">
        <div class="form-card-header">
          <h2 class="section-title">Perfil de Acesso</h2>
          <% if (usuario.nome) { %>
            <p class="card-subtitle"><%= usuario.nome %></p>
          <% } %>
        </div>
        <div class="form-card-body">
          <div class="form-group">
            <label class="form-label" for="role_id">Perfil <span class="required">*</span></label>
            <select class="form-select" id="role_id" name="role_id" required>
              <% (perfis || []).forEach((perfil) => { %>
                <option value="<%= perfil.id %>" <%= usuario.perfil_acesso_id === perfil.id ? 'selected' : '' %>>
                  <%= perfil.nome %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Atualizar Perfil</button>
      </div>
    </form>
  <% } else { %>
    <div class="empty-state">
      <p class="empty-title">Usuário indisponível</p>
      <p class="empty-text">Não foi possível carregar os dados deste usuário.</p>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
